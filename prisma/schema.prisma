generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Ayuda {
  id            String        @id @default(cuid())
  nombre        String
  barrio        String
  municipio     String        @default("Quibdó")
  telefono      String?
  necesidades   String
  urgencia      Urgencia      @default(URGENTE)
  lat           Float?
  lng           Float?
  ayudado       Boolean       @default(false)
  verificaciones Verificacion[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Verificacion {
  id        String   @id @default(cuid())
  ayudaId   String
  ayuda     Ayuda    @relation(fields: [ayudaId], references: [id], onDelete: Cascade)
  nombre    String
  estrellas Int      @default(5)
  comentario String
  createdAt DateTime @default(now())
}

enum Urgencia {
  CRITICA
  URGENTE
  MODERADA
}